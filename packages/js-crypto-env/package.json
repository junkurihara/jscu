{
  "name": "js-crypto-env",
  "version": "1.0.5",
  "description": "Shared environment modules for jscu",
  "main": "dist/index.js",
  "scripts": {
    "test": "pnpm jest",
    "tsc": "tsc --build ./tsconfig.json",
    "babel": "cross-env NODE_ENV=production pnpm tsc",
    "build": "rm -rf ./dist && npm run babel",
    "cleanup": "rm -rf ./dist coverage ./node_modules",
    "vitest": "vitest run",
    "vitest:browser": "vitest run --config ./vitest.browser.config.js",
    "vitest:watch": "vitest",
    "vitest:ui": "vitest --ui"
  },
  "author": "Jun Kurihara",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junkurihara/jscu.git"
  },
  "bugs": {
    "url": "https://github.com/junkurihara/jscu/issues"
  },
  "homepage": "https://github.com/junkurihara/jscu/tree/master/packages/js-crypto-env#readme",
  "keywords": [
    "jscu"
  ],
  "engines": {
    "node": ">=24.0.0"
  }
}
